{% from 'partials/menu.jinja2' import action_menu %}
<div class="card-header bg-dark text-white">
  <div class="card-title-with-badge">
    <h2 class="card-title mb-0">Bots</h2>
    <span class="badge bg-dark-subtle text-dark-emphasis rounded-pill" title="{{ bots | length }} bot(s) registered">
      {{ bots | length }}
    </span>
  </div>
</div>
<div class="card-body">
  <div class="table-responsive">
    <table class="table table-sm table-striped table-hover">
      <thead class="table-dark">
        <tr>
          <th>Username</th>
          <th>Nickname</th>
          <th>DID</th>
          <th>Class</th>
          <th>Resource</th>
          <th>Company</th>
          <th>Firmware</th>
          <th>Errors</th>
          <th>Connected</th>
          <th class="text-end">Action</th>
        </tr>
      </thead>
      <tbody>
        {% for bot in bots %}
          <tr>
            <td title="{{ bot.name }}">{{ bot.name }}</td>
            <td title="{{ bot.nick }}">{{ bot.nick }}</td>
            <td title="{{ bot.did }}">{{ bot.did }}</td>
            <td title="{{ bot.class_id }}">{{ bot.class_id }}</td>
            <td title="{{ bot.resource }}">{{ bot.resource }}</td>
            <td title="{{ bot.company }}">{{ bot.company }}</td>
            <td title="{{ bot.fw_ver or 'the robot did not report a version' }}">{{ bot.fw_ver or "-" }}</td>
            <td>
              {% if bot.device_errors %}
                {% for error in bot.device_errors %}
                  <a
                    class="badge bg-warning text-dark error-tag"
                    href="#error-detail-dialog"
                    data-error-code="{{ error.code }}"
                    data-error-name="{{ error.name }}"
                    data-error-description="{{ error.description }}"
                    data-error-recommendation="{{ error.recommendation }}"
                    data-error-source="{{ bot.device_error_source }}"
                    data-error-time="{{ bot.device_error_received_at }}"
                    aria-label="Error {{ error.code }}: {{ error.description }}"
                    aria-haspopup="dialog"
                  >{{ error.code }}</a>
                  {% if not loop.last %}<br />{% endif %}
                {% endfor %}
                {% if bot.device_error_previous_codes %}
                  <div class="small text-secondary">Previous: {{ bot.device_error_previous_codes | join(", ") }}</div>
                {% endif %}
              {% elif bot.device_error_reported and bot.device_error_previous_codes %}
                <div class="small text-secondary">Cleared: {{ bot.device_error_previous_codes | join(", ") }}</div>
              {% endif %}
            </td>
            <td>
              {% if bot.mqtt_connection and bot.xmpp_connection %}
                <span class="badge bg-success" title="MQTT & XMPP">MQTT & XMPP</span>
              {% elif bot.mqtt_connection %}
                <span class="badge bg-success" title="MQTT">MQTT</span>
              {% elif bot.xmpp_connection %}
                <span class="badge bg-success" title="XMPP">XMPP</span>
              {% else %}
                <span class="badge bg-danger" title="Disconnected">Disconnected</span>
              {% endif %}
            </td>
            <td class="actions">{{ action_menu('bot', bot.did, 'robot ' ~ (bot.nick or bot.did), bot.nick or '') }}</td>
          </tr>
        {% else %}
          <tr>
            <td colspan="10" class="text-center">No bots found.</td>
          </tr>
        {% endfor %}
      </tbody>
    </table>
  </div>
</div>
