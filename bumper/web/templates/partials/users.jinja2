{% from 'partials/menu.jinja2' import action_menu %}
<div class="card-header bg-dark text-white">
  <div class="card-title-with-badge">
    <h2 class="card-title mb-0">Users</h2>
    <span class="badge bg-dark-subtle text-dark-emphasis rounded-pill" title="{{ users | length }} user(s) registered">
      {{ users | length }}
    </span>
  </div>
</div>
<div class="card-body">
  <div class="table-responsive">
    <table class="table table-sm table-striped table-hover">
      <thead class="table-dark">
        <tr>
          <th>Username</th>
          <th>Nickname</th>
          <th>UID</th>
          <th>Devices</th>
          <th class="text-end">Action</th>
        </tr>
      </thead>
      <tbody>
        {% for user in users %}
        <tr>
          <td title="{{ user.username }}">{{ user.username }}</td>
          <td title="{{ user.nickname }}">{{ user.nickname }}</td>
          <td title="{{ user.userid }}">{{ user.userid }}</td>
          <td title="{{ user.devices }}">{{ user.devices }}</td>
          <td class="actions">
            {{ action_menu('user', user.userid, 'user ' ~ user.username, user.nickname or '') }}
          </td>
        </tr>
        {% else %}
        <tr>
          <td colspan="5" class="text-center">No users found.</td>
        </tr>
        {% endfor %}
      </tbody>
    </table>
  </div>
</div>
