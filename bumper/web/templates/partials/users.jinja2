{% from 'partials/menu.jinja2' import action_menu %}
<div class="card-header bg-dark text-white">
  <div class="card-title-with-badge">
    <h2 class="card-title mb-0">Users</h2>
    <span class="badge bg-dark-subtle text-dark-emphasis rounded-pill" title="{{ users | length }} user(s) registered">
      {{ users | length }}
    </span>
  </div>
</div>
<div class="card-body">
  <div class="table-responsive">
    <table class="table table-sm table-striped table-hover">
      <thead class="table-dark">
        <tr>
          <th>Username</th>
          <th>Login name</th>
          <th>UID</th>
          <th>IoT ID</th>
          <th>Devices</th>
          <th class="text-end">Action</th>
        </tr>
      </thead>
      <tbody>
        {% for user in users %}
          <tr>
            <td title="{{ user.username }}">{{ user.username }}</td>
            <td title="{{ user.login_name }}">{{ user.login_name }}</td>
            <td title="{{ user.account_id }}">{{ user.account_id }}</td>
            <td title="{{ user.iot_id }}">{{ user.iot_id }}</td>
            <td title="Robots: {{ user.bots }} | App devices: {{ user.devices }}">{{ user.bots }}</td>
            <td
              class="actions"
            >{{ action_menu('user', user.userid, 'user ' ~ user.username, user.nickname or '') }}</td>
          </tr>
        {% else %}
          <tr>
            <td colspan="6" class="text-center">No users found.</td>
          </tr>
        {% endfor %}
      </tbody>
    </table>
  </div>
</div>
